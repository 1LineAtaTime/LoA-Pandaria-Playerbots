##################################################
# PLAYERBOT CONFIGURATION FILE                   #
##################################################
[playerbots]
ConfVersion=2024050400

###################################################################################################
# SECTION INDEX
#   GENERAL SETTINGS
#	PLAYERBOT SETTINGS
#		GENERAL
#		SUMMON OPTIONS
#       MOUNT
#		GEAR
#		LOOTING
#		TIMERS
#		DISTANCES
#		THRESHOLDS
#		QUESTS
#		COMBAT
#		CHEATS
#		SPELLS
#	PLAYERBOT RNDBOT SPECIFIC SETTINGS
#		GENERAL
#		LEVELS
#		RANDOM BOT LEVEL MANAGEMENT (LEVEL BRACKETS + LEVEL RESET)
#		GEAR
#		QUESTS
#		ACTIVITIES
#		SPELLS
#		PROFESSIONS
#		STRATEGIES
#		TELEPORTS
#		BATTLEGROUND & ARENA & PVP
#		INTERVALS
#	PREMADE SPECS
#		INFORMATION
#		WARRIOR
#		PALADIN
#		HUNTER
#		ROGUE
#		PRIEST
#		DEATHKNIGHT
#		SHAMAN
#		MAGE
#		WARLOCK
#		MONK
#		DRUID
#	RANDOM BOT DEFAULT TALENT SPEC 
#    	WARRIOR
# 		PALADIN
#       HUNTER
#   	ROGUE
#   	PRIEST
#   	DEATHKNIGHT
#	    SHAMAN
#   	MAGE
#   	WARLOCK
#   	DRUID
#	PLAYERBOT SYSTEM SETTINGS
#		DATABASE & CONNECTIONS
#		DEBUG		
#		CHAT SETTINGS
#		LOGS
#	DEPRECIATED (TEMPORARY)
#
#
#
#
#
###################################################################################################

###################################################################################################

###################################
#                                 #
# GENERAL SETTINGS                #
#                                 #
###################################

####################################################################################################

# Enable or disable AI Playerbot
AiPlayerbot.Enabled = 1

# Enable random bot system
AiPlayerbot.RandomBotAutologin = 1

# Random bot account
# Please ensure that RandomBotAccountCount is greater than (MaxRandomBots / 10 + AddClassAccountPoolSize)
# Kept at 200 (AC: 0 = automatic): this fork has no automatic account calculation (RandomPlayerbotFactory.cpp uses the
# configured number as is, code default 200), so 0 would create no accounts. 200 accounts cover 500 bots
# (500 / 10 + AddClassAccountPoolSize 50 = 100).
AiPlayerbot.RandomBotAccountCount = 200

# Randombot count
AiPlayerbot.MinRandomBots = 500
AiPlayerbot.MaxRandomBots = 500

# Delete all random bot accounts (reset randombots)
AiPlayerbot.DeleteRandomBotAccounts = 0

# Disable randombots when no real players are logged in
# Default: 0 (randombots will login when server starts)
# If enabled, randombots will only log in 30 seconds (default) after a real player logs in, and will
# log out 300 seconds (default) after all real players log out
AiPlayerbot.DisabledWithoutRealPlayer = 0
AiPlayerbot.DisabledWithoutRealPlayerLoginDelay = 30
AiPlayerbot.DisabledWithoutRealPlayerLogoutDelay = 300

###################################################################################################

###################################
#                                 #
# PLAYERBOT SETTINGS              #
#                                 #
###################################

####################################################################################################

####################################################################################################
# GENERAL
#
#

# Maximum number of bots added by one account
AiPlayerbot.MaxAddedBots = 40

# Maximum number of bots per class added by one account
AiPlayerbot.MaxAddedBotsPerClass = 40

# Enable/Disable create bot by addclass command (0 = GM only, 1 = enable)
# default: 1 (enable)
AiPlayerbot.AddClassCommand = 1

# Set the addclass command account pool size
# Addclass command uses a subset of accounts from RandomBotAccountCount
AiPlayerbot.AddClassAccountPoolSize = 50

# Bot group invitation permission level (0 = GM only, 1 = accept based on level, 2 = always accept)
# default: 1 (accept based on level)
AiPlayerbot.GroupInvitationPermission = 1

# Keep altbots in the party even when the master leaves
# 0 = disabled (default behavior)
# 1 = enabled (prevents bots from automatically leaving the group)
AiPlayerbot.KeepAltsInGroup = 0

# auto-login all player alts as bots on player login
AiPlayerbot.BotAutologin = 0

# Allow/deny inviting altbots from the player's account
AiPlayerbot.AllowAccountBots = 1

# Allow login other players' characters as bots
# Default: 0 (disabled)
AiPlayerbot.AllowPlayerBots = 0

# Allow/deny bots from your guild
AiPlayerbot.AllowGuildBots = 1

# Allow linking accounts for shared altbot control
AiPlayerbot.AllowTrustedAccountBots = 1

# Randombots will invite nearby bots to guilds
AiPlayerbot.RandomBotGuildNearby = 0

# Randombots will invite players to groups/raids/guilds.
AiPlayerbot.RandomBotInvitePlayer = 0

# Bots will chat in say/guild when they invite other bots to groups/raids/guilds
AiPlayerbot.InviteChat = 0

# Bots will be summoned to player when accept group invitation
AiPlayerbot.SummonWhenGroup = 1

# Added following config
# Selfbot permission level (0 = disabled, 1 = gm only (default), 2 = all players, 3 = activate on login)
AiPlayerbot.SelfBotLevel = 1

# Give free food to bots
# Default: 1 (enabled)
AiPlayerbot.FreeFood = 1

# Non-GM player can only use init=auto to initialize bots based on their own level and gear score
# default: 0 (non-gm player can use any intialization commands)
AiPlayerbot.AutoInitOnly = 0

# The upper limit ratio of bot equipment level for init=auto
# default: 1.0 (same with the player)
AiPlayerbot.AutoInitEquipLevelLimitRatio = 1.0

# AllowLearnTrainerSpells
# Description: Allow the bot to learn trainers' spells as long as it has the money.
# Default: 1 - (enabled)
AiPlayerbot.AllowLearnTrainerSpells = 1

# Allow bots to send mail. When disabled, bots will not mail items or money in
# response to chat commands ("send mail").
# Default: 1 (enabled)
AiPlayerbot.BotSendMailEnabled = 1

# Bot automatically trains spells when talking to trainer (yes = train all available spells as long as the bot has the money, free = auto trains with no money cost, no = only list spells)
AiPlayerbot.AutoTrainSpells = yes

#
#
#
####################################################################################################

####################################################################################################
# SUMMON OPTIONS
#
#

# Enable/Disable summoning bots when the master is in combat
# default: 1 (enabled)
AiPlayerbot.AllowSummonInCombat = 1

# Enable/Disable summoning bots when the master is dead
# default: 1 (enabled)
AiPlayerbot.AllowSummonWhenMasterIsDead = 1

# Enable/Disable summoning bots when they are dead (0 = only when the bots are ghosts, 1 = always)
# default: 1 (always)
AiPlayerbot.AllowSummonWhenBotIsDead = 1

# Enable/Disable reviving the bots when summoning them (0 = disable, 1 = disable in combat, 2 = enable)
# default: 1 (disable in combat)
AiPlayerbot.ReviveBotWhenSummoned = 1

# Enable/Disable bot repair gear when summon (0 = no, 1 = yes)
# default: 1
AiPlayerbot.BotRepairWhenSummon = 1

#
#
#
####################################################################################################

####################################################################################################
# MOUNT
#
#

# Defines at what level a bot will naturally use its 60% ground mount
# note: was level 20 during WotLK, 30 during TBC, 40 during Vanilla
# default: 20
AiPlayerbot.UseGroundMountAtMinLevel = 20

# Defines at what level a bot will naturally use its 100% fast ground mount
# note: was level 40 during WotLK, 60 during Vanilla
# default: 40
AiPlayerbot.UseFastGroundMountAtMinLevel = 40

# Defines at what level a bot will naturally use its 150% fly mount
# note: was level 60 during WotLK, 70 during TBC
# default: 60
AiPlayerbot.UseFlyMountAtMinLevel = 60

# Defines at what level a bot will naturally use its 280% fast fly mount
# note: was level 70 during WotLK and TBC
# default: 70
AiPlayerbot.UseFastFlyMountAtMinLevel = 70

# Beyond AC (owner 2026-10-14): extra flying mounts, in addition to AC's gryphons / wind riders.
# Comma separated mount SPELL ids, each optionally "spellId:minBotLevel" (default: UseFlyMountAtMinLevel).
# Fly-tier mounts (UseFlyMountAtMinLevel / UseFastFlyMountAtMinLevel) are picked uniformly from AC's list plus
# these lists, and every bot without any extra flyer gets one on its next Refresh. Faction lists are added
# for that faction only. Empty = AC behaviour. Cloud Serpents (MountType 263) also teach Cloud Serpent Riding (130487).
# 5.4.8 note: Cold Weather Flying (54197), Flight Master's License (90267) and Wisdom of the Four Winds (115913,
# bot level 90) are learned by BotFactory::InitMountSpells; the extras need no extra licence.
# default: both faction lists empty
AiPlayerbot.RandomBotFlyingMountsExtra = "39798:70,39800:70,39801:70,39802:70,39803:70,40192:70,41513:70,41514:70,41515:70,41516:70,41517:70,41518:70,43927:70,59567:70,59568:70,59569:70,59570:70,59571:70,59650:70,59961:70,59976:70,59996:70,60002:70,60021:70,60024:70,60025:70,61294:70,63796:70,63844:70,63956:70,63963:70,69395:70,72807:70,72808:70,88331:80,88335:80,88718:80,88741:80,88742:80,88744:80,88746:80,88990:80,93326:80,93623:60,96503:70,97359:85,97493:85,97501:85,97560:85,107842:85,107844:85,107845:85,110039:85,113199:85,123992:85,123993:85,124408:85,127154:85,127156:85,127158:85,127161:85,127164:85,127165:85,127169:85,127170:85,129918:85,132036:85,139442:85,148476:85,129552:85,132117:85,132118:85,132119:85,130092:85,133023:70,136400:80,139448:90,148392:90"
AiPlayerbot.RandomBotFlyingMountsExtraAlliance = "61229:70,66087:70,130985:70,135416:80,136163:80"
AiPlayerbot.RandomBotFlyingMountsExtraHorde = "61230:70,66088:70,118737:70,135418:80,136164:80"

#
#
#
####################################################################################################

####################################################################################################
# GEAR
#
#

# Show helmet and cloak on randombots (reset required)
AiPlayerbot.RandomBotShowHelmet = 1
AiPlayerbot.RandomBotShowCloak = 1

# Bots equip upgrades (Bots will equip any item obtained from looting or a quest if they are upgrades)
# Default: 1 (enable)
AiPlayerbot.AutoEquipUpgradeLoot = 1

# Equip upgrade threshold for auto equip upgrade
# Default: 1.1 (Equip when the equipment score is 1.1 times higher than the current)
AiPlayerbot.EquipUpgradeThreshold = 1.1

# Two rounds of equipment initialization to create more suitable gear
AiPlayerbot.TwoRoundsGearInit = 0

#
#
#
####################################################################################################

####################################################################################################
# LOOTING
#
#

# Bots will say information about items when collecting them
AiPlayerbot.SayWhenCollectingItems = 1

# Bots keep looting when group loop method is free for all
# Default: 0 (disabled)
AiPlayerbot.FreeMethodLoot = 0

# Bots' Roll level bots will use for items they Need (0 = pass, 1 = greed, 2 = need)
# Default: 1 (greed)
AiPlayerbot.LootNeedRollLevel = 1

# Enable bots to roll GREED on items (global toggle)
# If disabled, bots will PASS instead of GREED on all items
# Default: 0 (disabled - bots only NEED or PASS)
AiPlayerbot.LootGreedRollLevel = 0

# Enable bots to roll on recipes. Will NEED on learnable profession recipes they don't already know
# Bots will roll GREED on BoE recipes they can't learn if LootRollGreed is enabled.
# Default: 0 (disabled)
AiPlayerbot.LootRollRecipe = 0

# Bots with enchanting will roll DISENCHANT instead of GREED on disenchantable items
# If disabled, bots will GREED on disenchantable items instead
# Default: 0 (disabled)
AiPlayerbot.LootRollDisenchant = 0

# A list of GameObject GUIDs that bots will not interact with.
# List of default GUIDs:
# QuestItems:
# Blood of Heroes = 176213, Defias Gunpowder = 17155, Waterlogged Envelope = 2656, Baelog's Chest = 123329, Half-Buried Bottle = 2560
# Chests:
# Large Solid Chest = 74448, Box of Assorted Parts = 19020, Food Crate = 3719, Water Barrel = 3658, Barrel of Milk = 3705, Barrel of sweet Nectar = 3706, Tattered Chest = 105579, Large bettered Chest = 75293, Solid Chest = 2857, Battered Foodlocker = 179490, Witch Doctor's Chest = 141596, Relic Coffer = 160836, Dark Coffer = 160845, Fengus's Chest = 179516, Supply Crate = 176224/181085, Malor's Strongbox = 176112
# Other:
# Shallow Grave (Zul'Farrak) = 128308/128403, Grim Guzzler Boar (Blackrock Depths) = 165739, Dark Iron Ale Mug (Blackrock Depths) = 165738, Father Flame (Blackrock Spire) = 175245, Unforged Runic Breastplate (Blackrock Spire) = 175970, Blacksmithing Plans (Stratholme) = 176325/176327
AiPlayerbot.DisallowedGameObjects = 176213,17155,2656,74448,19020,3719,3658,3705,3706,105579,75293,2857,179490,141596,160836,160845,179516,176224,181085,176112,128308,128403,165739,165738,175245,175970,176325,176327,123329,2560

# Bots loot roll level (0 = pass, 1 = greed, 2 = need)
# Default: 1 (greed)
AiPlayerbot.LootRollLevel = 1

#
#
#
####################################################################################################

####################################################################################################
# TIMERS
#
#

# Max AI iterations per tick
AiPlayerbot.IterationsPerTick = 10

# Delay between two short-time spells cast
AiPlayerbot.GlobalCooldown = 500

# Max wait time when moving
AiPlayerbot.MaxWaitForMove = 5000

# Disables use of MoveSplinePath for bot movement, will result in more erratic bot movement but means stun/snare/root/etc
# will work on bots (they wont reliably work when MoveSplinePath is enabled, though slowing effects still work ok)
# Default: 0 - MoveSplinePath enabled
#          1 - MoveSplinePath disabled in BG/Arena only
#          2 - MoveSplinePath disabled everywhere
AiPlayerbot.DisableMoveSplinePath = 0

# Max search time for movement (higher for better movement on slopes)
# default: 3
AiPlayerbot.MaxMovementSearchTime = 3

# Action expiration time
AiPlayerbot.ExpireActionTime = 5000

# Max dispel auras duration
AiPlayerbot.DispelAuraDuration = 700

# Delay between two bot actions
AiPlayerbot.ReactDelay = 100

# Dynamically adjust react delay for bots in different status to reduce server lags
AiPlayerbot.DynamicReactDelay = 1

# Inactivity delay
AiPlayerbot.PassiveDelay = 10000

# Minimum delay between repeating actions (chat messages, emotes etc)
AiPlayerbot.RepeatDelay = 2000

# Delay timers
AiPlayerbot.ErrorDelay = 100
AiPlayerbot.RpgDelay = 10000
AiPlayerbot.SitDelay = 20000
# ReturnDelay has a minimum value of 2000 - lower values will cause a crash!
AiPlayerbot.ReturnDelay = 2000
AiPlayerbot.LootDelay = 1000

#
#
#
####################################################################################################

####################################################################################################
# DISTANCES
#
#

# Distances are in yards
AiPlayerbot.FarDistance = 20.0
AiPlayerbot.SightDistance = 100.0
AiPlayerbot.SpellDistance = 28.5
AiPlayerbot.ShootDistance = 5.0
AiPlayerbot.ReactDistance = 150.0
AiPlayerbot.GrindDistance = 75.0
AiPlayerbot.HealDistance = 38.5
AiPlayerbot.LootDistance = 15.0
AiPlayerbot.FleeDistance = 5.0
AiPlayerbot.TooCloseDistance = 5.0
AiPlayerbot.MeleeDistance = 0.75
AiPlayerbot.FollowDistance = 1.5
AiPlayerbot.WhisperDistance = 6000.0
AiPlayerbot.ContactDistance = 0.45
AiPlayerbot.AoeRadius = 10
AiPlayerbot.RpgDistance = 200
AiPlayerbot.AggroDistance = 22

#
#
#
####################################################################################################

####################################################################################################
#THRESHOLDS
#
#

# Set kill XP rate for bots (default: 1)
# Server XP Rate * AiPlayerbot.KillXPRate
AiPlayerbot.KillXPRate = 1

# Health/Mana levels
AiPlayerbot.CriticalHealth = 25
AiPlayerbot.LowHealth = 45
AiPlayerbot.MediumHealth = 65
AiPlayerbot.AlmostFullHealth = 85
AiPlayerbot.LowMana = 15
AiPlayerbot.MediumMana = 40
AiPlayerbot.HighMana = 65

#
#
#
####################################################################################################

####################################################################################################
# QUESTS
#
#

# Bots pick their quest reward (yes = picks the most useful item, no = list all rewards, ask = pick useful item and lists if multiple)
AiPlayerbot.AutoPickReward = yes

# Sync quests with player (Bots will complete quests the moment you hand them in. Bots will ignore looting quest items.)
# Default: 1 (enable)
AiPlayerbot.SyncQuestWithPlayer = 1

# Bots will auto-complete quests for the player when handing in
# Default: 0 (disabled)
AiPlayerbot.SyncQuestForPlayer = 0

# Bots will drop obsolete quests
# Default: 1 (enabled)
AiPlayerbot.DropObsoleteQuests = 1

#
#
#
####################################################################################################

####################################################################################################
# COMBAT
#
#

# Auto add dungeon/raid strategies when entering the instance if implemented
AiPlayerbot.ApplyInstanceStrategies = 1

# Enable auto avoid aoe (experimental)
# Default: 1 (enable)
AiPlayerbot.AutoAvoidAoe = 1

# Only avoid aoe spells with a radius smaller than this value
AiPlayerbot.MaxAoeAvoidRadius = 15.0

# A whitelist of aoe spell IDs that should not be avoided
AiPlayerbot.AoeAvoidSpellWhitelist = 50759,57491,13810,29946

# Enable healer bot save mana
# Default: 1 (enable)
AiPlayerbot.AutoSaveMana = 1

# Healer bot save mana threshold
# Default: 60 (60%)
AiPlayerbot.SaveManaThreshold = 60

# When a ready check is issued out of combat, bots refresh missing/short buffs before reporting ready.
# A bot that still has buff work it can perform stays not-ready until the ready check ends; this
# includes missing reagents (the cast is attempted and fails). Uses the always-on "force rebuff"
# strategy: bots with strategy sets saved before this feature keep their saved set - reset their
# strategies or use "nc +force rebuff" to opt them in. The "rebuff" chat command starts the same
# buff pass without a ready check and works regardless of this setting.
# Default: 0 (disabled)
AiPlayerbot.ForceRebuffOnReadyCheck = 0

# During a force-rebuff pass (ready check or the "rebuff" command), a buff is topped off (recast)
# once it drops more than this many seconds below its full duration, so buffs are refreshed toward
# maximum remaining time to last the fight. The effective margin never drops below the time the
# pass has already run, so small values are safe.
# Default: 60
AiPlayerbot.ForceRebuffMarginSecs = 60

# Bot can flee for enemy
AiPlayerbot.FleeingEnabled = 1

#
#
#
####################################################################################################

####################################################################################################
# CHEATS
#
#

# Enable/Disable maintenance command, learn all available spells and skills, supplement consumables, repair, etc.
# default: 1 (enable)
AiPlayerbot.MaintenanceCommand = 1

# Enable/Disable autogear command, auto upgrade player bots gears, the quality is limited by AutoGearQualityLimit and AutoGearScoreLimit
# default: 1 (enable)
AiPlayerbot.AutoGearCommand = 1

# Enable/Disable autogear command on player alt bots
# Default: 1 (enable)
AiPlayerbot.AutoGearCommandAltBots = 1

# Equips quality limitation for auto gear command (1 = normal, 2 = uncommon, 3 = rare, 4 = epic, 5 = legendary)
# default: 3 (rare)
AiPlayerbot.AutoGearQualityLimit = 3

# Equips item level (not gearScore) limitation for auto gear command (0 = no limit)
# default: 0 (no limit)
AiPlayerbot.AutoGearScoreLimit = 0

# Enables/Disables bot cheating
# Supported cheats:
# "food" (bots eat/drink instantly via the Graccu's Mince Meat Fruitcake aura instead of sitting)
# "taxi" (bots may use all flight paths, though they will not actually learn them)
# "raid" (bots use certain cheats implemented into raid strategies)
# (AC also defines "gold", "health", "mana", "power"; this fork does not implement those yet.)
# To use multiple cheats, separate them by commas below
# Default: food, taxi, and raid are enabled
AiPlayerbot.BotCheats = "food,taxi,raid"

# Min random delay before the 1st follower bot clicks the flight-master (ms)
AiPlayerbot.BotTaxiDelayMinMs = 350

# Upper bound for the overall taxi delay window (ms) - larger spreads big raids
AiPlayerbot.BotTaxiDelayMaxMs = 5000

# Fixed gap added per group-slot so bots never take off together (ms)
AiPlayerbot.BotTaxiGapMs = 200

# Extra small randomness added to each gap so launches don't look robotic (ms)
AiPlayerbot.BotTaxiGapJitterMs = 100

#
#
#
####################################################################################################

####################################################################################################
# SPELLS
#
#

# ID of spell to open lootable chests
AiPlayerbot.OpenGoSpell = 6477

#
#
#
###################################################################################################

#######################################
#                                     #
# PLAYERBOT RNDBOT SPECIFIC SETTINGS  #
#                                     #
#######################################

####################################################################################################
# GENERAL
#
#

# Enables/Disables password to bot account
AiPlayerbot.RandomBotRandomPassword = 0

# Accounts to create for random bots
AiPlayerbot.RandomBotAccountPrefix = "rndbot"

# Enable/Disable rotation of bots (randomly select a bot from the bots pool to go online and rotate them periodically)
# Need to reset rndbot after changing the setting (.playerbot rndbot reset)
# default: 0 (disable, the online bots are fixed)
AiPlayerbot.EnableRotation = 0

# Bots pool size for rotation (should be less than RandomBotAccountCount * 10)
AiPlayerbot.RotationPoolSize = 500

AiPlayerbot.RandomBotMinLevel = 1
AiPlayerbot.RandomBotMaxLevel = 80

# Sync max random bot level with max level of online players
# Default: 0 (disabled)
AiPlayerbot.SyncLevelWithPlayers = 0

# Mark many quests <= Bot level as complete (slows down bot creation)
AiPlayerbot.PreQuests = 0

# Enable LFG for random bots (#142, AC conf.dist:751-753): random bots queue for the dungeons real players are
# queued for (CheckLfgQueue snapshot, every 30 s) and fill their role (tank/healer/dps by spec).
# Default: 1 (enabled)
AiPlayerbot.RandomBotJoinLfg = 1

# #702 (beyond AC): any-level dungeon finder. When a real player queues a dungeon outside its own level range
# (worldserver.conf LFG.AnyLevel.Enable = 1), random bots within LevelWindow levels of that player queue for it
# instead of bots in the dungeon's own range (bots in range still join when an in-range real player queued it too).
# Needs LFG.AnyLevel.Enable = 1 in worldserver.conf (otherwise the core keeps the bots' level locks). Random bots
# still only use LFG from level 15 (AC's LfgJoinAction rule). Read every 30 s (CheckLfgQueue).
# Default: 0 (disabled) / 3
AiPlayerbot.LfgAnyLevel.Enable = 0
AiPlayerbot.LfgAnyLevel.LevelWindow = 3

# #830 (beyond AC, needs AiPlayerbot.LfgAnyLevel.Enable = 1): a bot taken through that level window must also have an
# average equipped item level within ItemLevelWindow item levels of the requester's (the dungeon finder's own item-level
# measure). For a premade group both the level window and the item level are those of its highest-level member
# (AutoBalance scales the instance to that level). Read every 30 s (CheckLfgQueue).
# Default: 0 (off: the level window alone)
AiPlayerbot.LfgAnyLevel.ItemLevelWindow = 0

# #702 P4 / #831 (beyond AC): any-level battlegrounds. When a real player is queued in (or playing) a battleground bracket
# below its own level (worldserver.conf Battleground.AnyLevel.Enable = 1 filed it under a fallback bracket), random bots
# within LevelWindow levels of that player, of both factions, queue that bracket instead of bots of the bracket's own
# levels (those still join when an in-range real player waits in the same bracket too). Arenas are not affected.
# Needs Battleground.AnyLevel.Enable = 1 in worldserver.conf (otherwise no real player is ever below its bracket).
# The window is wider than LFG's because a battleground needs 10-15 bots a side, not 4. Read every
# AiPlayerbot.BgCheckInterval seconds (CheckBgQueue).
# Default: 0 (disabled) / 5
AiPlayerbot.BgAnyLevel.Enable = 0
AiPlayerbot.BgAnyLevel.LevelWindow = 5

# #702 P5 / #832 (AC skirmish fill + a level window beyond AC): any-level arena skirmishes. When a real player waits in an
# arena skirmish (worldserver.conf Arena.AnyLevel.Enable = 1 makes every arena join below the maximum level a skirmish),
# lone random bots within LevelWindow levels of that player, of both factions, queue that skirmish in the player's
# bracket (up to the bracket's highest level), with AC's skirmish quota (2 teams + 1 spare team per waiting match).
# Rated arena parties are not affected. Needs Arena.AnyLevel.Enable = 1 in worldserver.conf (otherwise no skirmish exists).
# The default window of 2 keeps a match within 4 levels, the width of one native arena bracket. Read every
# AiPlayerbot.BgCheckInterval seconds (CheckBgQueue).
# Default: 0 (disabled) / 2
AiPlayerbot.ArenaAnyLevel.Enable = 0
AiPlayerbot.ArenaAnyLevel.LevelWindow = 2

# Enable/Disable periodic online - offline of randombots to mimic the real-world scenario where not all players are online simultaneously
# When enabled, randombots are randomly selected to go online or offline periodically from a larger set
# Default: 0 (disabled, the set of online bots remains fixed)
AiPlayerbot.EnablePeriodicOnlineOffline = 0

# Defines the ratio between the total number of randombots (including offline ones) and the number of randombots currently online (MaxRandomBots)
# This setting must greater than 1.0 and only applies when EnablePeriodicOnlineOffline
# Default: 2.0 (total number of bots is twice the number of MaxRandomBots)
AiPlayerbot.PeriodicOnlineOfflineRatio = 2.0

# Percentage ratio of Alliance and Horde randombots
AiPlayerbot.RandomBotAllianceRatio = 50
AiPlayerbot.RandomBotHordeRatio = 50

# Disable logging in of death knight bots
AiPlayerbot.DisableDeathKnightLogin = 0

# Enable simulated expansion limitation for talents and glyphs
# If enabled, limits talent trees to 6 rows plus the middle talent of the 7th row for bots until level 61
# and 8 rows plus the middle talent of the 9th row for bots from level 61 until level 71
# Default: 0 (disabled)
AiPlayerbot.LimitTalentsExpansion = 0

# Configure randombot trading (0: Disabled, 1: Enabled, 2: Only Buy, 3: Only Sell)
# Default: 1 (enabled)
AiPlayerbot.EnableRandomBotTrading = 1

# Configure message prefixes which will be excluded in analysis in trade action to open trade window
AiPlayerbot.TradeActionExcludedPrefixes = "RPLL_H_,DBMv4,{звезда} Questie,{rt1} Questie"

# Number of seconds bots flagged as permanent stay in the world (31,104,000 ~ 1 year)
# Default: 31104000
AiPlayerbot.PermanentlyInWorldTime = 31104000

#
#
#
####################################################################################################

####################################################################################################
# LEVELS
#
#

# Disable randombots being generated with a random level
# If disabled, every randombot starts on a specified level (but can still level up by killing mobs and questing)
AiPlayerbot.DisableRandomLevels = 0

# Set randombots' starting level here if "AiPlayerbot.DisableRandomLevels" is enabled
AiPlayerbot.RandombotStartingLevel = 1

# Chance randombot has max level on first randomize
# Default 0.1 (10%)
AiPlayerbot.RandomBotMaxLevelChance = 0.1

# Chance random bot has min level on first randomize (AC default 0.1; #808)
AiPlayerbot.RandomBotMinLevelChance = 0.1

# Fix the level of random bot (won't level up by grinding)
# Default: 0 (disable)
AiPlayerbot.RandomBotFixedLevel = 0

# Set RandomBotMaxLevel bots to RandomBotMinLevel or not
AiPlayerbot.DowngradeMaxLevelBot = 0

#
#
#
####################################################################################################

####################################################################################################
# RANDOM BOT LEVEL MANAGEMENT (LEVEL BRACKETS + LEVEL RESET)
#
# #148: port of AC's random bot level management (AC conf.dist "RANDOM BOT LEVEL MANAGEMENT",
# AC Bot/RandomBotLevelMgr.cpp). Same keys and defaults as AC; the level values are extended to the 5.4.8 cap
# (90 instead of AC's 80). Both sub-features are opt-in and OFF by default, as on AC.
#
#   - Level Brackets: periodically redistributes random bots across configurable per-faction level
#     brackets, optionally weighting the distribution toward brackets that contain real (non-bot)
#     players. Instead of a one-shot downgrade (AiPlayerbot.DowngradeMaxLevelBot), it continuously
#     rebalances the whole random bot population across brackets over time.
#
#   - Level Reset: when a random bot reaches a configured max level, resets it back down to a lower
#     level via a full randomize, with an optional percent chance (optionally scaled by level), an
#     optional minimum played-time restriction, and an optional "skip" that sends a bot straight to a
#     different level as soon as it reaches a configured trigger level.
#
# NOTE: Level Reset overlaps with AiPlayerbot.DowngradeMaxLevelBot, which downgrades a bot that is
#       already at RandomBotMaxLevel to RandomBotMinLevel the next time it is periodically
#       re-randomized. Do not normally enable both AiPlayerbot.DowngradeMaxLevelBot and
#       AiPlayerbot.ResetBotLevel.Enabled at the same time.
# NOTE: ".reload config" picks up changed values only once the reload hook is wired in mod_playerbots.cpp
#       (RandomBotLevelMgrReloadConfig); otherwise restart the server.
#

##############################################
# Level Brackets
##############################################

# Enables the level brackets feature.
# Default: 0 (disabled)
AiPlayerbot.LevelBrackets.Enabled = 0

# The frequency (in seconds) at which the bot level distribution check is performed.
# Default: 300
AiPlayerbot.LevelBrackets.CheckFrequency = 300

# The frequency (in seconds) at which pending level resets are processed for safe bots and flagged
# bots that failed safety checks initially.
# Default: 15
AiPlayerbot.LevelBrackets.CheckFlaggedFrequency = 15

# Maximum number of flagged bots to process per pending level change step.
# 0 = unlimited (process all flagged bots each step)
# Default: 5
AiPlayerbot.LevelBrackets.FlaggedProcessLimit = 5

# When enabled, bots in a guild led by a real (non-bot) player are excluded from bot bracket
# calculations and will not be level changed or flagged (a guild counts as real when its leader is
# not a random-bot account).
# Default: 1 (enabled)
AiPlayerbot.LevelBrackets.IgnoreGuildBotsWithRealPlayers = 1

# When enabled, bots that are members of arena teams are excluded from bot bracket calculations.
# 5.4.8 has no arena teams (patch 5.4.0), so this has nothing to exclude; kept for AC parity.
# Default: 1 (enabled)
AiPlayerbot.LevelBrackets.IgnoreArenaTeamBots = 1

# Ignore bots that are on real players' friends lists from any brackets.
# Default: 1 (enabled)
AiPlayerbot.LevelBrackets.IgnoreFriendListed = 1

# Comma-separated list of bot names to exclude from all bracket checks. Names must match the
# character name exactly (character names are stored capitalized, e.g. "Thrall").
# Default: ""
AiPlayerbot.LevelBrackets.ExcludeNames = ""

# The number of level brackets used for bot distribution. Both Alliance and Horde should have the
# same number of brackets defined below.
# Default (code, as AC): 9 - this file ships 10 so the 5.4.8 range 80-89 and the level-90 cap each get
# a bracket (AC: 70-79 and its cap 80).
#
# IMPORTANT: If you extend the number of brackets, you must add configuration lines for the
#            additional brackets below (e.g. Range11, Range12, etc.). Ensure that the sum of the Pct
#            values for each faction remains 100.
AiPlayerbot.LevelBrackets.NumRanges = 10

# Enables dynamic recalculation of bot distribution percentages based on the number of non-bot
# players present in each level bracket. This overrides any custom brackets in the conf.
# Default: 0 (disabled)
AiPlayerbot.LevelBrackets.Dynamic.UseDynamicDistribution = 0

# Controls how much extra weight is given to brackets (level ranges) that contain real (non-bot)
# players, when dynamic distribution is enabled. 0.0 = bots always distribute evenly; 1.0 = mild;
# 3.0 = stronger; 5.0 = strong but not extreme; 10-15 for a large congestion of bots in your bracket.
# Formula (per bracket):
#   bracket_weight = 1.0 + (RealPlayerWeight x (1 / TotalRealPlayers) x log(1 + RealPlayersInBracket))
#   All bracket weights are normalized to total 100%.
# Default: 1.0
AiPlayerbot.LevelBrackets.Dynamic.RealPlayerWeight = 1.0

# If enabled, both Alliance and Horde must have identical bracket definitions (same number, same
# level bounds). All real players (regardless of faction) influence the dynamic distribution for
# both factions. If the brackets do not match, SyncFactions is forcibly disabled for that session
# and an error is logged; the server will not fail to start over this.
# Default: 0 (disabled)
AiPlayerbot.LevelBrackets.Dynamic.SyncFactions = 0

##############################################
# Alliance Level Brackets Configuration
##############################################
#    AiPlayerbot.LevelBrackets.Alliance.RangeX.Lower  - lower bound (inclusive) of bracket X
#    AiPlayerbot.LevelBrackets.Alliance.RangeX.Upper  - upper bound (inclusive) of bracket X
#    AiPlayerbot.LevelBrackets.Alliance.RangeX.Pct    - desired percentage of Alliance bots in bracket X
# Bounds are clamped to [RandomBotMinLevel, RandomBotMaxLevel]; a bracket that ends up empty gets 0%.
# NOTE: The sum of all Pct values for the Alliance brackets must equal 100.
#
# Pct is 10 for each of the 10 brackets (AC: 12/11 over 9 brackets): the level-90 cap and the 80-89 range are MoP-only brackets.
AiPlayerbot.LevelBrackets.Alliance.Range1.Lower = 1
AiPlayerbot.LevelBrackets.Alliance.Range1.Upper = 9
AiPlayerbot.LevelBrackets.Alliance.Range1.Pct   = 10

AiPlayerbot.LevelBrackets.Alliance.Range2.Lower = 10
AiPlayerbot.LevelBrackets.Alliance.Range2.Upper = 19
AiPlayerbot.LevelBrackets.Alliance.Range2.Pct   = 10

AiPlayerbot.LevelBrackets.Alliance.Range3.Lower = 20
AiPlayerbot.LevelBrackets.Alliance.Range3.Upper = 29
AiPlayerbot.LevelBrackets.Alliance.Range3.Pct   = 10

AiPlayerbot.LevelBrackets.Alliance.Range4.Lower = 30
AiPlayerbot.LevelBrackets.Alliance.Range4.Upper = 39
AiPlayerbot.LevelBrackets.Alliance.Range4.Pct   = 10

AiPlayerbot.LevelBrackets.Alliance.Range5.Lower = 40
AiPlayerbot.LevelBrackets.Alliance.Range5.Upper = 49
AiPlayerbot.LevelBrackets.Alliance.Range5.Pct   = 10

AiPlayerbot.LevelBrackets.Alliance.Range6.Lower = 50
AiPlayerbot.LevelBrackets.Alliance.Range6.Upper = 59
AiPlayerbot.LevelBrackets.Alliance.Range6.Pct   = 10

AiPlayerbot.LevelBrackets.Alliance.Range7.Lower = 60
AiPlayerbot.LevelBrackets.Alliance.Range7.Upper = 69
AiPlayerbot.LevelBrackets.Alliance.Range7.Pct   = 10

AiPlayerbot.LevelBrackets.Alliance.Range8.Lower = 70
AiPlayerbot.LevelBrackets.Alliance.Range8.Upper = 79
AiPlayerbot.LevelBrackets.Alliance.Range8.Pct   = 10

AiPlayerbot.LevelBrackets.Alliance.Range9.Lower = 80
AiPlayerbot.LevelBrackets.Alliance.Range9.Upper = 89
AiPlayerbot.LevelBrackets.Alliance.Range9.Pct   = 10

AiPlayerbot.LevelBrackets.Alliance.Range10.Lower = 90
AiPlayerbot.LevelBrackets.Alliance.Range10.Upper = 90
AiPlayerbot.LevelBrackets.Alliance.Range10.Pct   = 10

##############################################
# Horde Level Brackets Configuration
##############################################
#    AiPlayerbot.LevelBrackets.Horde.RangeX.Lower  - lower bound (inclusive) of bracket X
#    AiPlayerbot.LevelBrackets.Horde.RangeX.Upper  - upper bound (inclusive) of bracket X
#    AiPlayerbot.LevelBrackets.Horde.RangeX.Pct    - desired percentage of Horde bots in bracket X
# NOTE: The sum of all Pct values for the Horde brackets must equal 100.
#
AiPlayerbot.LevelBrackets.Horde.Range1.Lower = 1
AiPlayerbot.LevelBrackets.Horde.Range1.Upper = 9
AiPlayerbot.LevelBrackets.Horde.Range1.Pct   = 10

AiPlayerbot.LevelBrackets.Horde.Range2.Lower = 10
AiPlayerbot.LevelBrackets.Horde.Range2.Upper = 19
AiPlayerbot.LevelBrackets.Horde.Range2.Pct   = 10

AiPlayerbot.LevelBrackets.Horde.Range3.Lower = 20
AiPlayerbot.LevelBrackets.Horde.Range3.Upper = 29
AiPlayerbot.LevelBrackets.Horde.Range3.Pct   = 10

AiPlayerbot.LevelBrackets.Horde.Range4.Lower = 30
AiPlayerbot.LevelBrackets.Horde.Range4.Upper = 39
AiPlayerbot.LevelBrackets.Horde.Range4.Pct   = 10

AiPlayerbot.LevelBrackets.Horde.Range5.Lower = 40
AiPlayerbot.LevelBrackets.Horde.Range5.Upper = 49
AiPlayerbot.LevelBrackets.Horde.Range5.Pct   = 10

AiPlayerbot.LevelBrackets.Horde.Range6.Lower = 50
AiPlayerbot.LevelBrackets.Horde.Range6.Upper = 59
AiPlayerbot.LevelBrackets.Horde.Range6.Pct   = 10

AiPlayerbot.LevelBrackets.Horde.Range7.Lower = 60
AiPlayerbot.LevelBrackets.Horde.Range7.Upper = 69
AiPlayerbot.LevelBrackets.Horde.Range7.Pct   = 10

AiPlayerbot.LevelBrackets.Horde.Range8.Lower = 70
AiPlayerbot.LevelBrackets.Horde.Range8.Upper = 79
AiPlayerbot.LevelBrackets.Horde.Range8.Pct   = 10

AiPlayerbot.LevelBrackets.Horde.Range9.Lower = 80
AiPlayerbot.LevelBrackets.Horde.Range9.Upper = 89
AiPlayerbot.LevelBrackets.Horde.Range9.Pct   = 10

AiPlayerbot.LevelBrackets.Horde.Range10.Lower = 90
AiPlayerbot.LevelBrackets.Horde.Range10.Upper = 90
AiPlayerbot.LevelBrackets.Horde.Range10.Pct   = 10

##############################################
# Level Reset
##############################################

# Enables the level reset feature.
# Default: 0 (disabled)
AiPlayerbot.ResetBotLevel.Enabled = 0

# The maximum level a bot can reach before being reset.
# Default:     90 (AC: 80, the WotLK cap)
# Valid range: 2-90 (or 0 to disable the max-level reset check; SkipFromLevel/SkipToLevel still apply)
AiPlayerbot.ResetBotLevel.MaxLevel = 90

# The level bots will be reset to. For Death Knights, if this is below the heroic starting level,
# they will be reset to the heroic starting level instead.
# Default:     1
# Valid range: 1-89 and < MaxLevel
AiPlayerbot.ResetBotLevel.ResetToLevel = 1

# When a bot reaches exactly this level, it is sent directly to the level specified by SkipToLevel.
# This setting is not affected by ScaledChance or RestrictTimePlayed.
# Default:     0 (disabled)
# Valid range: 1-90 and < MaxLevel (or 0 to disable)
AiPlayerbot.ResetBotLevel.SkipFromLevel = 0

# The level bots will be sent to when they reach SkipFromLevel. For Death Knights, if this is below
# the heroic starting level, they will be reset to the heroic starting level instead.
# Default:     1
# Valid range: 1-90 and <= MaxLevel
AiPlayerbot.ResetBotLevel.SkipToLevel = 1

# The percent chance a bot has to have its level reset when reaching the max level (or the
# configured played time at max level).
# Default:     100
# Valid range: 0-100
AiPlayerbot.ResetBotLevel.ResetChance = 100

# If enabled, the reset chance is (re-)rolled every level-up and scales based on the distance
# between the bot's level and MaxLevel. Bots have a small chance of resetting at lower levels,
# increasing as they approach MaxLevel, where the chance reaches ResetChance.
# Default: 0 (disabled)
AiPlayerbot.ResetBotLevel.ScaledChance = 0

# If enabled, bots at MaxLevel will only have their level reset once they have played at least
# MinTimePlayed seconds at that level.
# Default: 0 (disabled)
AiPlayerbot.ResetBotLevel.RestrictTimePlayed = 0

# If RestrictTimePlayed is enabled, the minimum time (in seconds) a bot must have played at its
# current level before a reset can occur at MaxLevel.
# Default: 86400 (3600 = 1 hour, 86400 = 1 day, 604800 = 1 week)
AiPlayerbot.ResetBotLevel.MinTimePlayed = 86400

# If RestrictTimePlayed is enabled, the frequency (in seconds) at which the played-time check is
# performed for bots at or above MaxLevel.
# Default: 864
# Recommended: 1% of MinTimePlayed, or 300 seconds, whichever is higher.
AiPlayerbot.ResetBotLevel.PlayedTimeCheckFrequency = 864

# When enabled, bots in a guild led by a real (non-bot) player are excluded from level reset
# processing.
# Default: 0 (disabled)
AiPlayerbot.ResetBotLevel.IgnoreGuildBotsWithRealPlayers = 0

# Comma-separated list of bot names to exclude from level reset processing. Names must match the
# character name exactly (character names are stored capitalized, e.g. "Thrall").
# Default: "" (empty)
AiPlayerbot.ResetBotLevel.ExcludeNames = ""

#
#
####################################################################################################

####################################################################################################
# GEAR
#
#

# Equips quality limitation for random bots (1 = normal, 2 = uncommon, 3 = rare, 4 = epic, 5 = legendary)
# default: 3 (rare)
AiPlayerbot.RandomGearQualityLimit = 3

# Equips gear score limitation for random bots (0 = no limit)
# default: 0 (no limit)
AiPlayerbot.RandomGearScoreLimit = 0

# Prefer armor of the class's ideal type: apply 3x score multiplier to class-appropriate armor.
# When enabled, Warriors strongly prefer plate, Shamans prefer mail, etc.
# A truly superior item can still win (no hard filtering), but same-quality
# armor of the preferred type will score 3x higher and be equipped instead.
#
# ARMOR TYPE PREFERENCES:
#   Plate:   Warriors, Paladins, Death Knights
#   Mail:    Hunters, Shamans
#   Leather: Rogues, Druids
#   Cloth:   Priests, Mages, Warlocks
#
# Default: 0 (disabled)
AiPlayerbot.PreferClassArmorType = 0

# When enabled, bots prefer spec-appropriate weapons based on speed and weapon type during autogear.
# Examples: Arms Warriors favor slow 2H axes/polearms (Axe Specialization), Combat Rogues
# favor a slow MH with a fast OH, and Enhancement Shamans favor synchronized slow 1H weapons.
# Default: 0 (disabled)
AiPlayerbot.PreferredSpecWeapons = 0

# Set minimum level of randombots where gets enchants on items (Maxlevel + 1 to disable)
# Default: 60
AiPlayerbot.MinEnchantingBotLevel = 60

# Enable expansion limitation for enchants - ie: level <= 60 bot only uses enchants
# available in vanilla, level <= 70 bot only uses enchants available in TBC)
# Default: 1
AiPlayerbot.LimitEnchantExpansion = 1

# Enable expansion limitation for gear - ie: level <= 60 bot only uses gear
# available in vanilla, level <= 70 bot only uses gear available in TBC)
# Default: 1
AiPlayerbot.LimitGearExpansion = 1

# Change random bot has lower gear
AiPlayerbot.RandomGearLoweringChance = 0

# Randombots checking players gear score level and deny the group invite if it's too low
# Default: 0 (disabled)
AiPlayerbot.GearScoreCheck = 0

# Enable/Disable bot equipments persistence (stop random initialization) after certain level (EquipmentPersistenceLevel)
# default: 0 (disable)
AiPlayerbot.EquipmentPersistence = 0

# default: 80
AiPlayerbot.EquipmentPersistenceLevel = 80

# Randombots automatically upgrade equipments on levelup
# Default: 1 (enabled)
AiPlayerbot.AutoUpgradeEquip = 1

# Only set wolf pets for hunters to have higher damage (0 = disabled, 1 = enabled only for max-level, 2 = enabled)
# Default: 0 (disabled)
AiPlayerbot.HunterWolfPet = 0

# Default pet stance when a bot summons a pet
# 0 = Passive, 1 = Defensive, 2 = Aggressive
# Default: 1 (Defensive)
AiPlayerbot.DefaultPetStance = 1

# Enable/disable debug messages about pet commands
# 0 = Disabled, 1 = Enabled
# Default = 0 (disabled)
AiPlayerbot.PetChatCommandDebug = 0

#
#
#
####################################################################################################


####################################################################################################
# ACTIVITIES
#
#
# Specify percent of active bots
# The default is 10. With 10% of all bots going active or inactive each minute. Regardless
# This value is only applied to inactive areas where no real-players are detected, when
# real-players are nearby, friend, group, guild, bg, instances etc the value is always
# enforced to 100%
AiPlayerbot.BotActiveAlone = 10
AiPlayerbot.BotActiveAloneDurationSeconds = 30

# Force botActiveAlone when bot is ... of real player
AiPlayerbot.BotActiveAloneForceWhenInRadius = 150
AiPlayerbot.BotActiveAloneForceWhenInZone = 1
AiPlayerbot.BotActiveAloneForceWhenInMap = 0
AiPlayerbot.BotActiveAloneForceWhenIsFriend = 0
AiPlayerbot.BotActiveAloneForceWhenInGuild = 1

# SmartScale is enabled or not.
# The default is 1. When enabled (smart) scales the 'BotActiveAlone' value.
# (The scaling will be overruled by the BotActiveAloneForceWhen...rules)
#
#   Limitfloor - when DIFF (latency) above floor, activity scaling is applied starting with 90%
#   LimitCeiling - when DIFF (latency) above ceiling, activity is 0%;
#
#   MinLevel - only apply scaling when level is above or equal to min(bot)Level
#   MaxLevel - only apply scaling when level is lower or equal of max(bot)Level
#
AiPlayerbot.botActiveAloneSmartScale = 1
AiPlayerbot.botActiveAloneSmartScaleDiffLimitfloor = 50
AiPlayerbot.botActiveAloneSmartScaleDiffLimitCeiling = 200
AiPlayerbot.botActiveAloneSmartScaleWhenMinLevel = 1
# 90 (AC: 80): the 5.4.8 level cap.
AiPlayerbot.botActiveAloneSmartScaleWhenMaxLevel = 90

#
#
#
####################################################################################################

####################################################################################################
# QUESTS
#
#

# Quests that will be completed and rewarded for all randombots
AiPlayerbot.RandomBotQuestIds = "3802,5505,6502,7761,7848,10277,10285,11492,13188,13189,24499,24511,24710,24712"

# Randombots will group with nearby bots to do shared quests
AiPlayerbot.RandomBotGroupNearby = 0

# Random Bots will pick quests on their own and try to complete
# Default: 1 (enabled)
AiPlayerbot.AutoDoQuests = 1

# Random Bots will behave more like real players (exprimental)
# This option will override AiPlayerbot.AutoDoQuests, RandomBotTeleLowerLevel, and RandomBotTeleHigherLevel
# Default: 1 (enabled)
AiPlayerbot.EnableNewRpgStrategy = 1

# Status selection probability weights for the "new rpg" strategy. A bot in the IDLE status
# picks its next activity from these, skipping any that are unavailable where it stands (no
# camp/grind data, fewer than 3 NPCs nearby, no quest with a reachable objective, no flight
# master within 500 yd, ...). Weight 0 disables a status entirely.
#
#   WanderRandom  roam the immediate area
#   GoGrind       walk to a level-appropriate farm spot, then roam it
#   GoCamp        walk to a town/city hub, then visit its NPCs
#   WanderNpc     walk from NPC to NPC, pausing at each, taking and handing in quests
#   DoQuest       work a quest in the log: go to the objective POI, then back to hand it in
#   TravelFlight  walk to a flight master and take a real taxi to another zone
#   Rest          sit down for a moment
#   OutdoorPvp    walk to the capture points of the zone's outdoor-pvp event (Halaa, Zangarmarsh, ...)
#   DuelSpot      walk to a duel spot (see DUEL SPOTS below) and challenge the bots and players there; only
#                 bots with the "start duel" strategy (25 % of random bots) and only with DuelSpotEnable = 1
# #201 (#618): values aligned to AC mod-playerbots (AC conf.dist); DuelSpot is new (AC 0, this server 10).
AiPlayerbot.RpgStatusProbWeight.WanderRandom = 15
AiPlayerbot.RpgStatusProbWeight.GoGrind = 15
AiPlayerbot.RpgStatusProbWeight.GoCamp = 10
AiPlayerbot.RpgStatusProbWeight.WanderNpc = 20
AiPlayerbot.RpgStatusProbWeight.DoQuest = 60
AiPlayerbot.RpgStatusProbWeight.TravelFlight = 15
AiPlayerbot.RpgStatusProbWeight.Rest = 5
AiPlayerbot.RpgStatusProbWeight.OutdoorPvp = 10
AiPlayerbot.RpgStatusProbWeight.DuelSpot = 10

# #843 (MoP/Cata extension, owner 2026-10-16, BEYOND AC): quest hub search. Cataclysm rebuilt the old zones as
# chains: the givers at a hub often offer nothing until a chain starter elsewhere in the zone is done (Razor Hill's
# Gar'Thok needs 25168 from Sen'jin Village first), so a low-level bot found no quest at its hub and fell back to
# WanderNpc. With this on, when an IDLE bot has no quest it can work in its log, DoQuest stays a candidate: the bot
# walks (GoCamp travel) to the nearest quest giver in its zone, within RpgQuestHubSearchRadius yards, that has a quest
# it can take now (level, race, class, previous quest, exclusive group, not done), and takes it there through the
# normal accept path. A giver/quest pair it travelled to is not chosen again for 30 minutes; a search that finds
# nothing is not repeated for 2 minutes. Creature quest givers only. Not used in a deterministic (.botscenario
# pick=nearest) scenario. 0 = exactly AC.
#    Default: 1
AiPlayerbot.RpgQuestHubSearchEnable = 1
#    Default: 2500 (yards, the radius AC's GoCamp uses for a level 6+ bot)
AiPlayerbot.RpgQuestHubSearchRadius = 2500

# #218 (BEYOND AC, this fork only): roaming bots take boats, zeppelins, elevators, trams and flight paths on their own,
# over the travel-node graph (EnableTravelNodes). AC never leaves the map in NewRpg and teleports a bot that is stuck
# for 90 s; with this on, a bot stuck for 30 s whose graph route has an elevator / tram / boat / zeppelin / flight /
# portal leg follows it instead, and RoamTransportCampChance percent of GO_CAMP picks may choose a level-matched hub
# on another continent. 0 = exactly AC. Read once at first use (no .reload).
#    Default: 1
AiPlayerbot.RoamTransports = 1
#    Default: 10 (percent)
AiPlayerbot.RoamTransportCampChance = 10


####################################################################################################
# DUEL SPOTS  (#201: #612 status, #614 duel reset, #615 seeding, #618 weights)
####################################################################################################
# Random bots with the "start duel" strategy (25 % of them) walk to a duel spot and challenge the
# players and bots standing there, through the same "rpg duel" trigger and action as AC. The
# status is RpgStatusProbWeight.DuelSpot above (natural attraction) and, with DuelSpotSeedEnable,
# seeding (bots are teleported to the spot, re-levelled and re-geared to keep it busy).
#
# City spots (owner 2026-10-20): the capital gates (Stormwind, Orgrimmar, Ironforge, Undercity, Thunder Bluff,
# Silvermoon, Exodar), the Dalaran Underbelly (Circle of Wills) and the two Vale shrines hold only server-max-level
# bots (MinLevel 0 + MaxLevel 0: 90 on this server, 80 on a WotLK core) and 12 of them (6 pairs), with the pairs kept
# apart. The town spots (Goldshire, Razor Hill, Sen'jin, Crossroads, Booty Bay, Gurubashi, Halaa, Halfhill) are unchanged.
# The MoP 5.4.8 duel-spot behaviour is the pattern:
#   - one anchor point per spot; bots stand on a ring 10-30 yd around it (they are sent back to, and wander to, a point
#     urand(10, 30) yd from the POI), scan every 10-20 s, challenge the nearest eligible player within 10 yd, and
#     otherwise walk to within 3 yd of a random player within 50 yd;
#   - a bot only duels bots within 5 levels, and a level-90 bot only level-90 bots; no rematch with the same opponent
#     for 25-35 s, so partners rotate; the bot does not move while a duel runs;
#   - spots are kept at their bot count (the spot's bot count) by re-levelling and re-gearing free bots.
# A bot only starts a duel 10 yd or more (the MoP pairing distance) from every other duel running at the spot, and
# idle bots patrol the 10-yd-to-radius ring away from running duels. A spot never takes more than its .Bots bots of a
# team, by seeding or by natural attraction.
#
# Master switch. 0 = no status pick, no seeding, no duel reset.
# Default: 0 (this server: 1)
AiPlayerbot.DuelSpotEnable = 1

# Comma list of spot NAMES. Every name has its own block of AiPlayerbot.DuelSpot.<Name>.* keys below.
# A disabled spot, or one whose map does not exist, is ignored. The spot index is its position among
# the loaded spots.
AiPlayerbot.DuelSpots = "StormwindGate,OrgrimmarGate,RazorHill,SenjinVillage,Goldshire,IronforgeGate,ShrineSevenStars,ShrineTwoMoons,DalaranCircleOfWills,Crossroads,UndercityGate,ThunderBluffLifts,SilvermoonGate,ExodarGate,BootyBay,GurubashiArena,Halaa,Halfhill"

# Natural attraction: a bot picks the nearest spot on its own map within this many yards.
AiPlayerbot.DuelSpotSelectDistance = 1500
# A bot below this level never goes to a duel spot.
AiPlayerbot.DuelSpotMinLevel = 5
# Maximum concurrent duels inside one spot (owner 2026-10-20: 6 pairs at a city spot).
# Default: 4 (this server: 6)
AiPlayerbot.DuelSpotMaxDuels = 6
# Seconds before a bot challenges the same opponent again (random between Min and Max; MoP 25-35).
AiPlayerbot.DuelSpotRematchDelayMin = 25
AiPlayerbot.DuelSpotRematchDelayMax = 35
# Milliseconds between a bot's candidate scans (random between Min and Max; MoP 10-20 s).
AiPlayerbot.DuelSpotScanIntervalMin = 10000
AiPlayerbot.DuelSpotScanIntervalMax = 20000
# Candidates must be within this many levels of the bot (MoP: less than 6).
AiPlayerbot.DuelSpotMaxLevelDiff = 5
# If either side is at the server max level, both must be.
AiPlayerbot.DuelSpotMaxLevelPairsOnly = 1
# Only challenge players of the bot's own faction.
AiPlayerbot.DuelSpotSameTeamOnly = 1

# Bots challenge real players standing at a spot (as in MoP). Each scan a real candidate is
# considered with PlayerChallengeChance percent; after any bot challenged a player, that player is
# left alone for PlayerCooldown seconds. AFK, in-combat, mounted and casting players are never challenged.
# Default: 0 (this server: 1)
AiPlayerbot.DuelSpotChallengeRealPlayers = 1
AiPlayerbot.DuelSpotPlayerChallengeChance = 25
AiPlayerbot.DuelSpotPlayerCooldown = 900

# Duel reset for EVERY duel inside a spot, bots and players alike (mod-duel-reset):
# full health and mana at the start; at the end of every duel (won, fled, interrupted, surrendered) also all spell cooldowns and Forbearance.
# Default: 0 (this server: 1)
AiPlayerbot.DuelSpotReset = 1

# Seeding (needs DuelSpotEnable): every SeedInterval ms the random bot manager tops each spot up to its
# .Bots target per allowed team, taking idle random bots (not in a group, BG, arena or queue), re-levelling
# them into the spot's level band when SeedRelevel is on and re-gearing them when SeedRegear is on, and
# teleporting them 10-30 yd from the spot. A seeded bot that dies is revived after 30-60 s. At most
# SeedPerTick bots are seeded per tick, and at most SeedMaxShare percent of the online random bots may be
# seeded at once. A spot without AlwaysActive is only seeded while a real player is on its map within
# ActiveDistance yards. Seeded bots are released when they get a queue invite, a group with a real
# player, or the spot is disabled.
# Default: 0 (this server: 1)
AiPlayerbot.DuelSpotSeedEnable = 1
AiPlayerbot.DuelSpotSeedInterval = 5000
AiPlayerbot.DuelSpotSeedPerTick = 2
AiPlayerbot.DuelSpotSeedMaxShare = 25
AiPlayerbot.DuelSpotSeedRelevel = 1
AiPlayerbot.DuelSpotSeedRegear = 1
AiPlayerbot.DuelSpotActiveDistance = 1500

# Per-spot keys: AiPlayerbot.DuelSpot.<Name>.
#   Enable                  0/1
#   Map X Y Z Radius        anchor and radius in yards
#   Team                    0 both, 1 Alliance, 2 Horde
#   MinLevel MaxLevel       MaxLevel 0 = server max level (and values above it are clamped); MinLevel 0 together
#                           with MaxLevel 0 = server max level only (every city spot below)
#   Bots                    bots kept per allowed team: the seeding target (0 = this spot is never seeded) and the
#                           cap for natural attraction (city spots: 12 = 6 pairs)
#   AlwaysActive            1 = seeded even when no real player is on the map
#   AllowPvpProhibitedZone  1 = bots may duel here although the zone is in PvpProhibitedZoneIds
# Area ids and flags are the 5.4.8 AreaTable ones (duel bit 0x40).

