# Travel-node graph (issue #32).
#
# The travel graph is the long-distance counterpart to the mmap pathfinder: the core's
# PathGenerator only returns useful paths up to a few hundred yards, so without a graph a bot
# asked to cross a continent just walks into the first mountain. With this enabled the server
# builds a graph of flight masters, inns, spirit healers, instance portals, boats/zeppelins,
# player start locations and zone centres, links them with real walkable paths, and routes bots
# over it (A*), including taking flight paths and transports.
#
# The graph is stored in the playerbots database (playerbots_travelnode / _link / _path). It is
# generated from the live 5.4.8 game data the first time it is needed - that generation is slow
# (minutes to hours, depending on how many maps have mmaps) and blocks startup, but it only
# happens once: later boots load the stored graph. Regeneration is triggered automatically when
# the stored data was produced by an older generator.
#
# Default: 0 (disabled)
AiPlayerbot.EnableTravelNodes = 0

# Distance (yards) beyond which bots route through the travel graph instead of heading straight
# at the destination. Shorter moves stay on the plain mmap pathfinder, which is cheaper.
# Default: 500
AiPlayerbot.TravelNodeRouteDistance = 500

# Quest items to keep in bots' inventories (do not automatically destroy)
AiPlayerbot.RandomBotQuestItems = "5175,5176,5177,5178,6948,11000,12382,13704,16309"

