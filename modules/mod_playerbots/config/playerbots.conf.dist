#
#
#
####################################################################################################

####################################################################################################
# BATTLEGROUNDS & ARENAS & PVP
#
#

# Let random bots queue for battlegrounds, accept the invitation and enter the match (issue #33).
#
# Bots queue, enter, walk to their start position and play the objective: Warsong Gulch and Twin
# Peaks (flag carrying), Arathi Basin and Eye of the Storm (node capture). Battlegrounds with no
# ported tactics - Alterac Valley, Isle of Conquest and the Mists/Cataclysm maps - still get the
# shared objective layer, so bots enter and move but do not play those maps well.
#
# Arenas (#437): 5.4.8 has no arena teams (patch 5.4.0). A random bot gathers a party of its own faction
# and bracket and queues the rated 2v2/3v3/5v5 bracket; each player's rating is kept per bracket in
# characters.rated_pvp_info (slot 0/1/2). Bots fill a rated bracket a real player is waiting in, and with
# RandomBotAutoJoinBG they also keep the configured number of rated matches going (arena keys below).
#
# Default: 1 (enabled)
AiPlayerbot.RandomBotJoinBG = 1

# How often (seconds) the battleground queue census runs.
#
# Bots decide whether to fill a queue only from this census, so it is also the worst-case delay
# before a waiting player's queue starts getting bots. That matters more the bigger the
# battleground: Warsong Gulch needs 10 a side and pops in seconds, Arathi Basin needs 15 and was
# measured taking over three minutes at 30 s. Lower it to make queues pop sooner, at the cost of
# running the census more often. Upstream AzerothCore uses 35.
#
# Default: 30
AiPlayerbot.BgCheckInterval = 30

# Strand of the Ancients - beyond AC (AC has no SotA tactics; owner 2026-10-14, #736): the chance (0-100) that a
# demolisher gets a bot driver at all. One deterministic roll per vehicle per life (a destroyed and respawned
# demolisher rolls again); a demolisher that loses the roll is left for a player to drive. The harness verb
# `.botscenario - sotadrive <pct>|off` overrides it for a test (off = back to this key).
#
# Default: 70
AiPlayerbot.BgSotaVehicleDriveChance = 70

# Let bots open battleground queues themselves, so matches still form on a realm with no human
# players waiting. Requires RandomBotJoinBG. As on AC, nothing is seeded until every random bot is
# logged in (#582).
#
# This also controls how *concentrated* bots are. Without it they only fill queues somebody is
# already in; with 300 bots spread over every level bracket of every battleground, no single
# queue ever reaches the players-per-team a match needs. The bracket lists below say which
# (battleground, bracket) pairs to keep a queue open in, so bots converge on those.
#
# Brackets are PvPDifficultyEntry::RangeIndex OF THAT BATTLEGROUND'S MAP (#304): the index restarts at 0
# at each map's lowest level, so the same number is a different level range per battleground - see
# "Battleground bracket ids on 5.4.8" below. Leave a list empty to not auto-open that battleground.
# Counts are how many simultaneous instances to keep going.
#
# Example - keep one level-90 Warsong Gulch, Arathi Basin, Alterac Valley and Strand running:
#   AiPlayerbot.RandomBotAutoJoinBG = 1
#   AiPlayerbot.RandomBotAutoJoinWSBrackets = 16
#   AiPlayerbot.RandomBotAutoJoinABBrackets = 16
#   AiPlayerbot.RandomBotAutoJoinAVBrackets = 9
#   AiPlayerbot.RandomBotAutoJoinSABrackets = 5
#
# Default: 0 (disabled)
AiPlayerbot.RandomBotAutoJoinBG = 0
# #304: WS/AB/EY are AC's level-80 brackets (AC conf.dist: WS 7, AB 6, EY 2) translated to 5.4.8 ids (80-84),
# like IC/AV/SA below. TP is MoP-only and has no 80-84 bracket, so it stays closed unless set.
AiPlayerbot.RandomBotAutoJoinWSBrackets = 14
AiPlayerbot.RandomBotAutoJoinTPBrackets = ""
AiPlayerbot.RandomBotAutoJoinABBrackets = 14
AiPlayerbot.RandomBotAutoJoinEYBrackets = 9
# Old (pre-#304) spelling of the WS/TP/AB/EY counts. Still read, but only when the AC-named
# RandomBotAutoJoinBG<bg>Count key further down is absent; set the AC key instead.
AiPlayerbot.RandomBotAutoJoinWSCount = 1
AiPlayerbot.RandomBotAutoJoinTPCount = 1
AiPlayerbot.RandomBotAutoJoinABCount = 1
AiPlayerbot.RandomBotAutoJoinEYCount = 1

# Required Configuration for RandomBotAutoJoinBG
#
# Known issue: When enabling a lot of brackats in combination with multiple instances,
#              can lead to more instances created by bots than intended (over-queuing).
#
# This section controls the level brackets and 
# automatic bot participation in battlegrounds and arenas.
#
# Brackets:
# - Specify the level ranges for bots to auto-join:
#   - Warsong Gulch (WS): 0 = 10-19, 1 = 20-29, 2 = 30-39, ..., 7 = 80 (default: 7)
#   - Rated Arena: 0 = 10-14, 1 = 15-19, ..., 14 = 80-84 (default: 14)
# - Multiple brackets can be specified as a comma-separated list (e.g., "0,2,5").
#
# Counts:
# - Specify the number of Battlegrounds to auto-fill per bracket.
# - For battlegrounds, Count is the number of bots per bracket. For example:
#   - Warsong Gulch Count = 1 adds 20 bots (10 per team).
# - Ensure there are enough eligible bots to meet the specified counts.
#
# Arena Considerations:
# - Rated Arena brackets default to level 80-84 (bracket 14).
# - Custom code changes are required for lower-level arena brackets to function properly.
#
# Battleground bracket range possibilities (AC 3.3.5 numbering - NOT valid on 5.4.8, see below):
# AiPlayerbot.RandomBotAutoJoinICBrackets = 0,1
# AiPlayerbot.RandomBotAutoJoinEYBrackets = 0,1,2
# AiPlayerbot.RandomBotAutoJoinAVBrackets = 0,1,2,3
# AiPlayerbot.RandomBotAutoJoinABBrackets = 0,1,2,3,4,5,6
# AiPlayerbot.RandomBotAutoJoinWSBrackets = 0,1,2,3,4,5,6,7
#
# Battleground bracket ids on 5.4.8 (#304; PvpDifficulty.dbc RangeIndex per map, read 2026-10-09):
#   WS (489), AB (529): 0 = 10-14, +1 per 5 levels ... 14 = 80-84, 15 = 85-89, 16 = 90
#   AV (30):            0 = 45-49 ... 7 = 80-84, 8 = 85-89, 9 = 90
#   EY (566):           0 = 35-39 ... 9 = 80-84, 10 = 85-89, 11 = 90
#   SA (607):           0 = 65-69 ... 3 = 80-84, 4 = 85-89, 5 = 90
#   IC (628):           0 = 75-79, 1 = 80-84, 2 = 85-89, 3 = 90
#   TP (726), BFG (761): 0 = 85-89, 1 = 90
#   TOK (998), SM (727), DG (1105): 0 = 90 only
# A bracket id the map does not have is never matched by any bot (no queue opens).
#
# The defaults below are AC's level-80 brackets (AC: IC 1, AV 3 = level 80) translated to the same
# level here, so a seeded match is the 80-84 one on both servers. SA is MoP-only and follows them.
AiPlayerbot.RandomBotAutoJoinICBrackets = 1
AiPlayerbot.RandomBotAutoJoinAVBrackets = 7
AiPlayerbot.RandomBotAutoJoinSABrackets = 3
# Cataclysm/Mists battlegrounds (MoP-only, #304; AC has no counterpart): Battle for Gilneas, Temple of
# Kotmogu, Silvershard Mines (SM), Deepwind Gorge. None has an 80-84 bracket, so they stay closed unless set
# (e.g. level 90: BFG 1, TOK 0, SM 0, DG 0).
AiPlayerbot.RandomBotAutoJoinBFGBrackets = ""
AiPlayerbot.RandomBotAutoJoinTOKBrackets = ""
AiPlayerbot.RandomBotAutoJoinSMBrackets = ""
AiPlayerbot.RandomBotAutoJoinDGBrackets = ""

# Battlegrounds count (per bracket!):
AiPlayerbot.RandomBotAutoJoinBGICCount = 0
AiPlayerbot.RandomBotAutoJoinBGEYCount = 1
AiPlayerbot.RandomBotAutoJoinBGAVCount = 0
AiPlayerbot.RandomBotAutoJoinBGSACount = 1
AiPlayerbot.RandomBotAutoJoinBGABCount = 1
AiPlayerbot.RandomBotAutoJoinBGWSCount = 1
# Twin Peaks and the other MoP-only battlegrounds, AC's key spelling (default 1, like AC's WS/AB/EY).
AiPlayerbot.RandomBotAutoJoinBGTPCount = 1
AiPlayerbot.RandomBotAutoJoinBGBFGCount = 1
AiPlayerbot.RandomBotAutoJoinBGTOKCount = 1
AiPlayerbot.RandomBotAutoJoinBGSMCount = 1
AiPlayerbot.RandomBotAutoJoinBGDGCount = 1

# Arena bracket (single bracket only):
# Custom code changes are required for lower-level arena brackets to function properly.
# 5.4.8: brackets are PvPDifficultyEntry::RangeIndex of the arena map - 14 = level 80-84 (AC's default),
# 16 = level 90 on a 90-cap realm.
AiPlayerbot.RandomBotAutoJoinArenaBracket = 14

# Arena battles count: rated matches bots keep going in that bracket. Requires RandomBotAutoJoinBG, and
# (as on AC) starts only once every random bot is logged in.
AiPlayerbot.RandomBotAutoJoinBGRatedArena2v2Count = 0
AiPlayerbot.RandomBotAutoJoinBGRatedArena3v3Count = 0
AiPlayerbot.RandomBotAutoJoinBGRatedArena5v5Count = 0

# Rated battleground matches bots keep going (#897, beyond AC - AC has no rated BG). Level-max random bots
# gather a same-faction 10-man raid (2 while `.debug ratedbg` testing is on) and queue the rated battleground;
# a real player waiting in that queue also gets bot opponents. 0 = off. Requires RandomBotAutoJoinBG.
AiPlayerbot.RandomBotAutoJoinBGRatedBGCount = 0

# Random bot arena team count / rating / delete: AC keys (AC conf.dist:2065-2077), NOT SUPPORTED on 5.4.8 -
# arena teams were removed in patch 5.4.0 (#437, #409); bots gather a party per match instead. Commented out
# (#304: no key may look configured and do nothing); listed so the key set still maps to AC's.
# AiPlayerbot.RandomBotArenaTeam2v2Count = 10
# AiPlayerbot.RandomBotArenaTeam3v3Count = 10
# AiPlayerbot.RandomBotArenaTeam5v5Count = 5
# AiPlayerbot.RandomBotArenaTeamMaxRating = 2000
# AiPlayerbot.RandomBotArenaTeamMinRating = 1000
# AiPlayerbot.DeleteRandomBotArenaTeams = 0

# PvP Restricted Zones (bots will not initiate PvP or defend themselves if attacked)
AiPlayerbot.PvpProhibitedZoneIds = "2255,656,2361,2362,2363,976,35,2268,3425,392,541,1446,3828,3712,3738,3565,3539,3623,4152,3988,4658,4284,4418,4436,4275,4323,4395,3703,4298,3951"

