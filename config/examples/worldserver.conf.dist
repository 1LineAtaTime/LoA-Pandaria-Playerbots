#    TicketSystem
#        Description: Allow/disallow sending new GM tickets.
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

TicketSystem.GMTickets = 1

#
#    FeedBackSystem
#        Description: Allow/disallow sending new Bug , Suggestion , Complaint tickets.
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

TicketSystem.FeedBackTickets = 1

