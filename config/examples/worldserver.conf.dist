#        Default:     2

MaxPrimaryTradeSkill = 2

#
#    MinPetitionSigns
#        Description: Number of required signatures on charters to create a guild.
#        Range:       0-4
#        Default:     4

MinPetitionSigns = 4

#
#    MaxGroupXPDistance
#        Description: Max distance to creature for group member to get experience at creature
