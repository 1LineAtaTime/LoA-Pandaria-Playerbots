#        Default:     1

PlayerDump.DisallowOverwrite = 1

#
#     UI.ShowQuestLevelsInDialogs
#        Description: Show quest levels next to quest titles in UI dialogs
#        Example: [13] Westfall Stew
#        Default: 0 (do not show)

UI.ShowQuestLevelsInDialogs = 0

#
#     Calculate.Creature.Zone.Area.Data
#        Description: Calculate at loading creature zoneId / areaId and save in creature table (WARNING: SLOW WORLD SERVER STARTUP)
#        Default:     0  - (Do not show)

Calculate.Creature.Zone.Area.Data = 0

#
#     Calculate.Gameoject.Zone.Area.Data
#        Description: Calculate at loading gameobject zoneId / areaId and save in gameobject table (WARNING: SLOW WORLD SERVER STARTUP)
#        Default:     0  - (Do not show)

Calculate.Gameoject.Zone.Area.Data = 0

#
#     SoloQueue.Enabled
#        Description: Enables or disables the solo queue for arenas
#        Default:     1 - Enabled
#                     0 - Disabled

SoloQueue.Enabled = 0

#
#     SoloQueue.BalancePriortyEnabled
#        Description: Enables soloqueue matchmaking logic, with this disabled, teams will be formed much quicker, but with total lack of balance
#        Required by SoloQueue.MatchMakerRatingDifference and others
#        Default:     1 - Enabled
#                     0 - Disabled

SoloQueue.BalancePriortyEnabled = 0

#
#     SoloQueue.ProgressiveMMR.Enabled
#        Description: Allows to periodically increase the matchmaking range of the characters queued up, until a match is found or until SoloQueue.ProgressiveMMR.Threashold is reached
#        Default:     1 - Enabled
#                     0 - Disabled

SoloQueue.ProgressiveMMR.Enabled = 0

#
#     SoloQueue.ProgressiveMMR.OnlyHealers
#        Description: Allows to periodically increase the matchmaking range of ONLY the healers queued up, until a match is found or until SoloQueue.ProgressiveMMR.Threashold is reached
#        Default:     0 - Disabled
#                     1 - Enabled

SoloQueue.ProgressiveMMR.OnlyHealers = 1

#     SoloQueue.AllowQueueWithoutHealers
#        Description: Allows soloq matchmaking to form matches with groups that have only damage dealers.
#        Default:     1 - Enabled
#                     0 - Disabled

SoloQueue.AllowQueueWithoutHealers = 1

#
#     SoloQueue.InterfractionalTeams
#        Description: Enables or disables interfactional teams for soloq matchmaking
#        Default:     0 - Disabled
#                     1 - Enabled

SoloQueue.InterfractionalTeams = 0

#
#     SoloQueue.GroupRegistrationEnabled
#        Description: Enables or Disables the option to queue for 5v5 and 3v3 soloqueue has a group of two.
#        Default:     1 - Enabled
#                     0 - Disabled

SoloQueue.GroupRegistrationEnabled = 0

#
#     SoloQueue.GroupOnlyHealerAndDamager
#        Description: Limits the group queuing to those that are composed only by 1 healer and 1 dps
#                     Requires SoloQueue.GroupRegistrationEnabled
#        Default:     1 - Enabled
#                     0 - Disabled

SoloQueue.GroupOnlyHealerAndDamager = 0

#
#     SoloQueue.AllowBuyArenaStuff
#        Description: Allow players with enough 5v5 rating to buy arena itens while the soloq system is enabled, otherwise they cannot do it.
#        Default:     0 - Disabled
#                     1 - Enabled

SoloQueue.AllowBuyArenaStuff = 0

#
#     SoloQueue.AllowAchievements
#        Description: Allow players to earn arena achievements trough soloq
#        Default:     0 - Disabled
#                     1 - Enabled

SoloQueue.AllowAchievements = 1

#
#     SoloQueue.DeserterTimer.Leave
#        Description: Time in seconds that the soloq deserter will have before being able to queue up again.
#        Default:     900 (15 min)

SoloQueue.DeserterTimer.Leave = 900

#
#     SoloQueue.DeserterTimer.NotAccept
#        Description: Time in seconds that the soloq deserter that did not accept the arena queue will have before being able to queue up again.
#        Default:     900 (15 min)

SoloQueue.DeserterTimer.NotAccept = 900

#
#     SoloQueue.MatchMakerRatingDifference
#        Description: The max rating difference both queue soloq teams can have in order to be paired against each other
#        Default:     150

SoloQueue.MatchMakerRatingDifference = 150

#
#     SoloQueue.AverageItemlevel
#        Description: The average ilvl needed in order to join a soloq
#        Default:     0

SoloQueue.AverageItemlevel = 450

#
#     SoloQueue.GroupRatingDifference
#        Description: The maximum rating difference that the players must have in order to be put into the same group for a soloq match
#        Default:     150

SoloQueue.GroupRatingDifference = 150

#
#     SoloQueue.DeserterRatingPenalty
#        Description: The fixed amount of rating that an arena soloq deserter will lose.
#        Default:     20

SoloQueue.DeserterRatingPenalty = 20

#
#     SoloQueue.NotAcceptedRatingPenalty
#        Description: The fixed amount of rating that a player will lose for not accepting a soloq match invitation.
#        Default:     5

SoloQueue.NotAcceptedRatingPenalty = 20

#
#     SoloQueue.TeammateBaseRatingDifference
#        Description: The amount of base artificial MMR incrimentation the queue will give for the group each time its matchmaking system fails to find a matching group
#                     Note: Limited by SoloQueue.ProgressiveMMR.Threashold
#					  Note2: With SoloQueue.ProgressiveMMR.Enabled set to false, this value will be used only once, and never to be increased.
#        Default:     150

SoloQueue.TeammateBaseRatingDifference = 150

#
#     SoloQueue.ProgressiveMMR.Threashold
#        Description: The maximum amount of artificial MMR incrementation the queue will go in order to try to find a match.
#        Requires SoloQueue.ProgressiveMMR.Enabled set to true, with it set to false, this limit will never be reached unless SoloQueue.TeammateBaseRatingDifference is set to a higher value
#        Default:     400

SoloQueue.ProgressiveMMR.Threashold = 400

#
#     SoloQueue.TeammateBlockingTimer
#        Description: The amount of time that soloq teammates will be locked off of eachother before the matchmaking system allows them to be in the same team again.
#        Default:     300 (5 minutes)

SoloQueue.TeammateBlockingTimer = 300

#
#     SoloQueue.MinQueueSize
#        Description: The minimum amount of players in queue for the soloq matchmaking system to start forming groups.
#        Default:     6

SoloQueue.MinQueueSize = 6

#
#     SoloQueue.MinPvpPower
#        Description: The minimum amount of pvp power/healing the player needs to have in order to be able to queue for a soloq match
#        Default:     0

SoloQueue.MinPvpPower = 0

#
#     ICore.QueueAnnounce.Arena
#        Description: System announce in chat for normal arena queues
#        Default:  0 - Disabled
#                  1 - Enabled

ICore.QueueAnnounce.Arena = 0

#
#     ICore.QueueAnnounce.Arena.Solo
#        Description: System announce in chat for soloq arena queues
#        Default:  0 - Disabled
#                  1 - Enabled

ICore.QueueAnnounce.Arena.Solo = 0

#
#     ICore.QueueAnnounce.Battleground
#        Description: System announce in chat for battleground queues
#        Default:  0 - Disabled
#                  1 - Enabled

ICore.QueueAnnounce.Battleground = 0

#
#     ICore.QueueAnnounce.Raid
#        Description: System announce in chat for raid queues
#        Default:  0 - Disabled
#                  1 - Enabled

ICore.QueueAnnounce.Raid = 0

